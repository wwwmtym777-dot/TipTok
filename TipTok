class UploadScreen extends StatefulWidget {
const UploadScreen({Key? key}) : super(key: key);
@override
_UploadScreenState createState() => _UploadScreenState();
}

class _UploadScreenState extends State<UploadScreen> {
File? _video;
final _picker = ImagePicker();
final _caption = TextEditingController();
bool _isChallenge = false;
bool _uploading = false;

Future<void> _pick() async {
final XFile? file = await _picker.pickVideo(source: ImageSource.gallery, maxDuration: const Duration(seconds: 45));
if (file == null) return;
setState(() => _video = File(file.path));
}

Future<void> _upload() async {
if (_video == null || _caption.text.trim().isEmpty) return;
setState(() => _uploading = true);
try {
final uid = FirebaseAuth.instance.currentUser!.uid;
final userDoc = await FirebaseFirestore.instance.collection('users').doc(uid).get();
final userName = userDoc.data()?['name'] ?? 'anon';

// 1- ضغط/قص الفيديو إلى 45 ثانية  
  final tempDir = Directory.systemTemp;  
  final outPath = '${tempDir.path}/out_${DateTime.now().millisecondsSinceEpoch}.mp4';  
  final FlutterFFmpeg _ffmpeg = FlutterFFmpeg();  
  await _ffmpeg.execute('-i ${_video!.path} -ss 0 -t 45 -crf 28 -y $outPath');  

  // 2- رفع الملف  
  final ref = FirebaseStorage.instance.ref('videos/${p.basename(outPath)}');  
  final task = ref.putFile(File(outPath));  
  await task;  
  final url = await ref.getDownloadURL();  

  // 3- حفظ metadata  
  await FirebaseFirestore.instance.collection('videos').add({  
    'videoUrl': url,  
    'caption': _caption.text.trim(),  
    'uploaderId': uid,  
    'uploaderName': userName,  
    'likes': [],  
    'challenge': _isChallenge,  
    'createdAt': FieldValue.serverTimestamp(),  
  });  

  ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('تم الرفع!')));  
  Navigator.of(context).pop(); // عد للرئيسية  
} catch (e) {  
  ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text('فشل: $e')));  
} finally {  
  setState(() => _uploading = false);  
}

}

@override
Widget build(BuildContext context) {
return Scaffold(
appBar: AppBar(title: Text('رفع فيديو')),
body: SingleChildScrollView(
padding: EdgeInsets.all(24),
child: Column(
children: [
if (_video != null)
Container(
height: 200,
child: Center(child: Text('✔ تم اختيار الفيديو (45 ثانية)'))),
SizedBox(height: 12),
ElevatedButton.icon(
onPressed: _pick,
icon: Icon(Icons.video_library),
label: Text('اختر فيديو (ماكس 45 ثانية)')),
SizedBox(height: 20),
TextField(
controller: _caption,
decoration: InputDecoration(hintText: 'وصف الفيديو...'),
maxLines: 3),
SizedBox(height: 12),
CheckboxListTile(
title: Text('إضافة إلى تحدّي الأسبوع'),
value: _isChallenge,
onChanged: (v) => setState(() => _isChallenge = v ?? false)),
SizedBox(height: 20),
ElevatedButton(
onPressed: _uploading ? null : _upload,
child: _uploading
? CircularProgressIndicator(color: Colors.white)
: Text('نشر')),
],
),
),
);
}
